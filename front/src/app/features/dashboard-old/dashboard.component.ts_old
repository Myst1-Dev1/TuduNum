              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <span class="text-xs text-slate-400 font-medium block">09:00 AM</span>
              <h4 class="text-base font-bold text-white mt-0.5">Morning Standup</h4>
            </div>
          </div>

          <div class="bg-[#161f30] rounded-2xl p-4 border border-slate-800/50 flex items-center gap-4 shadow-md">
            <div class="w-12 h-12 rounded-xl bg-[#202b41] flex items-center justify-center text-purple-400">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 21l8.904-4.43a9.002 9.002 0 10-8.09-2.666z" /></svg>
            </div>
            <div>
              <span class="text-xs text-slate-400 font-medium block">11:30 AM</span>
              <h4 class="text-base font-bold text-white mt-0.5">Project Deep Dive</h4>
