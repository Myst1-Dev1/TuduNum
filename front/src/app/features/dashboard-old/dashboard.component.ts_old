          </span>
          <span class="text-slate-200">5</span><span class="text-slate-200">6</span><span class="text-slate-200">7</span><span class="text-slate-200">8</span>
        </div>
      </div>

      <div class="bg-[#161f30] rounded-2xl p-5 border border-slate-800/50 flex items-center justify-between shadow-lg">
        <div>
          <span class="text-[10px] font-bold tracking-widest text-slate-400 uppercase">Current Weather</span>
          <h2 class="text-2xl font-bold mt-0.5 text-white">24°C Cloudy</h2>
        </div>
        <div class="text-slate-300 drop-shadow-[0_0_8px_rgba(255,255,255,0.3)]">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" />
          </svg>
        </div>
      </div>

      <div class="space-y-4">
        <div class="flex items-center justify-between px-1">
          <h2 class="text-xl font-bold text-white">Next Reminders</h2>
          <button class="text-xs font-bold text-slate-400 hover:text-slate-200 uppercase tracking-wider">See All</button>
        </div>

        <div *ngIf="remindersService.upcomingReminders().length === 0" class="text-center py-8 text-slate-500">
          Nenhum lembrete pendente. Aproveite! 🎉
        </div>

        <div class="space-y-3">
          <div class="bg-[#161f30] rounded-2xl p-4 border border-slate-800/50 flex items-center gap-4 shadow-md">
