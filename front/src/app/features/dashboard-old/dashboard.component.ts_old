    <button (click)="setActiveTab('calendar')" class="flex flex-col items-center gap-1 group">
      <div [class]="activeTab() === 'calendar' ? 'bg-[#3b5998] text-white px-6 py-1.5 rounded-full shadow-[0_0_12px_rgba(59,89,152,0.4)]' : 'text-slate-500 group-hover:text-slate-300 px-6 py-1.5'" class="transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" />
        </svg>
      </div>
      <span [class]="activeTab() === 'calendar' ? 'text-white font-bold' : 'text-slate-500'" class="text-[10px] tracking-wide transition-colors">Weather</span>
    </button>

    <button (click)="setActiveTab('reminders')" class="flex flex-col items-center gap-1 group">
      <div [class]="activeTab() === 'reminders' ? 'bg-[#3b5998] text-white px-6 py-1.5 rounded-full shadow-[0_0_12px_rgba(59,89,152,0.4)]' : 'text-slate-500 group-hover:text-slate-300 px-6 py-1.5'" class="transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" />
        </svg>
      </div>
      <span [class]="activeTab() === 'reminders' ? 'text-white font-bold' : 'text-slate-500'" class="text-[10px] tracking-wide transition-colors">Map</span>
    </button>
  </nav>

</div>
  `,
  styles: []
})
export default class DashboardComponent implements OnInit {
  public authService = inject(AuthService);
  public onlineService = inject(OnlineService);
  public remindersService = inject(RemindersService);

  // Estado local
  activeTab = signal<'home' | 'calendar' | 'reminders'>('home');
  selectedDate = signal<Date | null>(null);
  editingReminder = signal<Reminder | null>(null);
  formError = signal<string | null>(null);

  ngOnInit(): void {
    this.loadReminders();
  }

  loadReminders(): void {
    this.remindersService.loadReminders(1, 10).subscribe({
      error: (err) => {
        console.error('Erro ao carregar reminders:', err);
      }
    });
  }

  setActiveTab(tab: 'home' | 'calendar' | 'reminders'): void {
    this.activeTab.set(tab);
  }

  selectDate(date: Date): void {
    this.selectedDate.set(date);
  }

  getRemindersForDate(date: Date): Reminder[] {
    return this.remindersService.getRemindersByDate(date);
  }

  openEditForm(reminder: Reminder): void {
    this.editingReminder.set(reminder);
    this.setActiveTab('reminders');
    this.formError.set(null);
  }

  clearForm(): void {
    this.editingReminder.set(null);
    this.formError.set(null);
  }

  submitForm(payload: CreateReminderRequest | UpdateReminderRequest): void {
    if (this.editingReminder()) {
      const reminderId = this.editingReminder()!.id;
      this.remindersService.updateReminder(reminderId, payload as UpdateReminderRequest).subscribe({
        next: () => {
          this.clearForm();
        },
        error: (err) => {
          this.formError.set(err?.error?.message || 'Erro ao atualizar lembrete');
        }
      });
    } else {
      this.remindersService.createReminder(payload as CreateReminderRequest).subscribe({
        next: () => {
          this.clearForm();
        },
        error: (err) => {
          this.formError.set(err?.error?.message || 'Erro ao criar lembrete');
        }
      });
    }
  }

  completeReminder(id: string): void {
    this.remindersService.completeReminder(id).subscribe({
      error: (err) => console.error('Erro ao completar:', err)
    });
  }

  reopenReminder(id: string): void {
    this.remindersService.reopenReminder(id).subscribe({
      error: (err) => console.error('Erro ao reabrir:', err)
    });
  }

  deleteReminder(id: string): void {
    this.remindersService.deleteReminder(id).subscribe({
      error: (err) => console.error('Erro ao deletar:', err)
    });
  }

  nextPage(): void {
    this.remindersService.nextPage().subscribe({
      error: (err) => console.error('Erro ao navegar página:', err)
    });
  }

  previousPage(): void {
    this.remindersService.previousPage().subscribe({
      error: (err) => console.error('Erro ao navegar página:', err)
    });
  }

  getStatusLabel(status: string): string {
    const labels = {
      PENDING: 'Pendente',
      COMPLETED: 'Concluído',
      ARCHIVED: 'Arquivado',
    };
    return labels[status as keyof typeof labels] || status;
  }

  getPriorityLabel(priority: string): string {
    const labels = {
      LOW: 'Baixa',
      MEDIUM: 'Média',
      HIGH: 'Alta',
    };
    return labels[priority as keyof typeof labels] || priority;
  }

  countByStatus(statusStr: string): number {
    const reminders = this.remindersService.filteredReminders();
    if (statusStr === 'PENDING') {
      return reminders.filter(r => r.status === ReminderStatus.PENDING).length;
    } else if (statusStr === 'COMPLETED') {
      return reminders.filter(r => r.status === ReminderStatus.COMPLETED).length;
    } else if (statusStr === 'ARCHIVED') {
      return reminders.filter(r => r.status === ReminderStatus.ARCHIVED).length;
    }
    return 0;
  }

  setStatusFilterHelper(status: string): void {
    if (status === 'ALL' || status === 'PENDING' || status === 'COMPLETED' || status === 'ARCHIVED') {
      this.remindersService.setStatusFilter(status as any);
    }
  }

  setPriorityFilterHelper(priority: string): void {
    if (priority === 'ALL' || priority === 'LOW' || priority === 'MEDIUM' || priority === 'HIGH') {
      this.remindersService.setPriorityFilter(priority as any);
    }
  }

  public logout(): void {
    this.authService.logout();
  }
}
