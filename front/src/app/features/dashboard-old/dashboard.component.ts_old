import { ReminderFormComponent } from '@shared/components/reminder-form/reminder-form.component';
import { ReminderCardComponent } from '@shared/components/reminder-card/reminder-card.component';
import { CalendarWidgetComponent } from '@shared/components/calendar-widget/calendar-widget.component';
import { signal } from '@angular/core';

@Component({
  selector: 'app-dashboard',
  standalone: true,
  imports: [
    CommonModule,
    ReminderFormComponent,
    ReminderCardComponent,
    CalendarWidgetComponent,
  ],
  template: `
    <div class="min-h-screen bg-[#0B1326] text-white font-sans antialiased flex flex-col justify-between mx-auto relative shadow-2xl">
  
  <header class="px-6 py-5 flex items-center justify-between sticky top-0 bg-[#0d1424]/90 backdrop-blur-md z-40">
    <div class="flex items-center gap-3">
      <button class="text-slate-400 hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
      <h1 class="text-3xl font-bold tracking-tight text-white drop-shadow-[0_0_8px_rgba(147,197,253,0.6)]">TuduNu</h1>
    </div>

    <div class="flex items-center gap-3">
      <span [class]="onlineService.isOnline() ? 'bg-emerald-500' : 'bg-rose-500'" class="w-2.5 h-2.5 rounded-full block"></span>
      <div class="w-9 h-9 rounded-full border border-slate-700 overflow-hidden bg-slate-800">
        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80" alt="Avatar" class="w-full h-full object-cover">
      </div>
    </div>
  </header>

  <main class="flex-1 px-5 pb-28 space-y-5 overflow-y-auto">

    <div *ngIf="activeTab() === 'home'" class="space-y-5">
      
      <div class="bg-[#161f30] rounded-2xl p-5 border border-slate-800/50 shadow-lg">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-bold text-slate-200">September 2024</h3>
          <div class="flex gap-2">
            <button class="p-1.5 rounded-full bg-slate-800/80 text-slate-400 hover:text-white text-xs">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
            </button>
            <button class="p-1.5 rounded-full bg-slate-800/80 text-slate-400 hover:text-white text-xs">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
            </button>
          </div>
        </div>
        
        <div class="grid grid-cols-7 gap-y-3 text-center text-xs font-semibold text-slate-500 mb-2">
          <span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span>
        </div>
        <div class="grid grid-cols-7 gap-y-4 text-center text-sm font-medium text-slate-600">
          <span>26</span><span>27</span><span>28</span><span>29</span><span>30</span><span>31</span><span class="text-slate-200">1</span>
          <span class="text-slate-200">2</span><span class="text-slate-200">3</span>
          <span class="relative flex items-center justify-center">
            <span class="absolute w-8 h-8 rounded-full bg-[#5c7fec] shadow-[0_0_12px_rgba(92,127,236,0.6)] z-0"></span>
