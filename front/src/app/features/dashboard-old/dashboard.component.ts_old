          <div class="bg-[#161f30] rounded-2xl p-4 border border-slate-800/50 flex items-center gap-4 shadow-md">
            <div class="w-12 h-12 rounded-xl bg-[#202b41] flex items-center justify-center text-emerald-400">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v16.5h16.5M12 7.5h7.5m-7.5 3h7.5M12 13.5h7.5" /></svg>
            </div>
            <div>
              <span class="text-xs text-slate-400 font-medium block">05:00 PM</span>
              <h4 class="text-base font-bold text-white mt-0.5">Gym Session</h4>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div *ngIf="activeTab() === 'calendar'" class="bg-[#161f30] rounded-2xl p-5 border border-slate-800/50">
      </div>
    
    <div *ngIf="activeTab() === 'reminders'" class="bg-[#161f30] rounded-2xl p-5 border border-slate-800/50">
      </div>

  </main>

  <button class="absolute bottom-24 right-6 w-14 h-14 bg-[#a9c2f7] hover:bg-blue-300 text-slate-900 rounded-full flex items-center justify-center shadow-[0_4px_20px_rgba(169,194,247,0.4)] transition-transform active:scale-95 z-50">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
